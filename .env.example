# PocketBase Configuration
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=your-secure-password

# Next.js Configuration
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# AI Configuration
# Set the API key for the provider you want. If exactly one key is present the
# provider is detected automatically; set AI_PROVIDER only to disambiguate.
# AI_PROVIDER=openai        # openai | google  (gemini is accepted for google)

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key-here

# --- Google Gemini ---
# GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_GENERATIVE_AI_API_KEY is also accepted, for parity with the AI SDK.

# Optional: override the model used for image analysis.
# Defaults: openai=gpt-5.4-2026-03-05, google=gemini-3.5-flash
# Other vision-capable Gemini ids: gemini-3.7-flash, gemini-2.5-pro,
# gemini-flash-latest. An unusable value falls back to the provider default
# and logs a warning; an unrecognised but well-formed id is passed through.
# AI_MODEL=gemini-3.5-flash

# Optional: override the API base URL to use a compatible endpoint
# (e.g. a proxy, Azure, or a self-hosted/local inference server)
# AI_BASE_URL=https://api.openai.com/v1

# Legacy aliases, still honoured when AI_MODEL / AI_BASE_URL are unset and the
# active provider is openai: OPENAI_MODEL, OPENAI_BASE_URL.

# CLI (@project/cli, binary `iw`)
# One absolute URL for the whole application. Behind nginx a single origin
# serves both PocketBase (/api/, /_/) and the webapp (/api-next/, /).
# Leave unset for local development: the CLI then falls back to
# http://localhost:8090 (PocketBase) and http://localhost:3000 (webapp).
# APP_URL=https://inventory.example.com
# Credentials are cached in ~/.config/inventory-ware/auth.json after `iw login`.
# IW_PASSWORD can supply the password non-interactively in scripts.

# Logging
# error | warn | info | debug | verbose. Read by the webapp logger and, in the
# Docker image, by every service in the container (see docker/README.md).
# LOG_LEVEL=info

# Development
NODE_ENV=development