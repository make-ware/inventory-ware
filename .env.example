# PocketBase Configuration
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=your-secure-password

# Next.js Configuration
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# AI Configuration
OPENAI_API_KEY=your-openai-api-key-here
# Optional: override the model used for image analysis (default: gpt-5.4-2026-03-05)
# OPENAI_MODEL=gpt-5.4-2026-03-05
# Optional: override the API base URL to use an OpenAI-compatible endpoint
# (e.g. a proxy, Azure, or a self-hosted/local inference server)
# OPENAI_BASE_URL=https://api.openai.com/v1

# CLI (@project/cli, binary `iw`)
# One absolute URL for the whole application. Behind nginx a single origin
# serves both PocketBase (/api/, /_/) and the webapp (/api-next/, /).
# Leave unset for local development: the CLI then falls back to
# http://localhost:8090 (PocketBase) and http://localhost:3000 (webapp).
# APP_URL=https://inventory.example.com
# Credentials are cached in ~/.config/inventory-ware/auth.json after `iw login`.
# IW_PASSWORD can supply the password non-interactively in scripts.

# Development
NODE_ENV=development